<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı: seri, rekor ve günlük ödül durumu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:text="YÖRÜNGE"
        android:textColor="#7CF3FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_daily"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🎁 Günlük ödülün hazır!"
        android:textColor="#FFD166"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🔥 Seri: 0 gün"
        android:textColor="#E8ECFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🚀 Rekor: 0"
        android:textColor="#E8ECFF"
        android:textSize="13sp" />
</LinearLayout>
